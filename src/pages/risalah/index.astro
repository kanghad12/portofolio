---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('risalah');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title="Risalah & Opini Islam — kanghadad.com" currentActive="risalah">
  <div class="container">
    <div class="main-layout">
      <!-- Main Content -->
      <div class="content-area">
        <h1 style="font-size: 2.2rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 8px;">📖 Risalah & Opini</h1>
        <p style="color: var(--text-muted); margin-bottom: 32px;">Catatan dakwah digital, fikih muamalah kontemporer, etika penggunaan teknologi, serta esai kritik sosial dari kacamata Islam.</p>

        {sortedPosts.length === 0 ? (
          <p style="color: var(--text-muted);">Belum ada risalah yang diterbitkan.</p>
        ) : (
          sortedPosts.map(post => (
            <PostCard entry={post} collection="risalah" />
          ))
        )}
      </div>

      <!-- Sidebar -->
      <aside class="sidebar-area">
        <div class="widget">
          <h3 class="widget-title">Fokus Risalah</h3>
          <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.6;">
            Mengintegrasikan logika teknologi modern dengan khazanah keilmuan Islam klasik demi terwujudnya kesadaran digital yang berkah dan beretika.
          </p>
        </div>
      </aside>
    </div>
  </div>
</Layout>
