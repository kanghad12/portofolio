---
import Layout from '../layouts/Layout.astro';
import SearchComponent from '../components/Search';
import { getCollection } from 'astro:content';

const informatikaPosts = await getCollection('informatika');
const risalahPosts = await getCollection('risalah');
const tutorialPosts = await getCollection('tutorial');

// Prepare items for client-side search component
const searchItems = [
  ...informatikaPosts.map((p) => ({
    slug: p.id,
    title: p.data.title,
    description: p.data.description,
    collection: 'informatika' as const,
    pubDate: p.data.pubDate.toISOString(),
    tags: p.data.tags,
    category: p.data.category,
    duration: p.data.duration,
  })),
  ...risalahPosts.map((p) => ({
    slug: p.id,
    title: p.data.title,
    description: p.data.description,
    collection: 'risalah' as const,
    pubDate: p.data.pubDate.toISOString(),
    tags: p.data.tags,
    duration: p.data.duration,
  })),
  ...tutorialPosts.map((p) => ({
    slug: p.id,
    title: p.data.title,
    description: p.data.description,
    collection: 'tutorial' as const,
    pubDate: p.data.pubDate.toISOString(),
    tags: p.data.tags,
    duration: p.data.duration,
  })),
];
---

<Layout title="Pencarian Catatan — kanghadad.com">
  <div class="container">
    <div style="padding: 40px 0;">
      <h1 style="font-size: 2.2rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 8px;">Pencarian Terpadu</h1>
      <p style="color: var(--text-muted); margin-bottom: 40px;">Cari materi Informatika, risalah dakwah, kumpulan tutorial, atau tag tertentu.</p>
      
      <!-- Client-side React Search Component with client:load directive -->
      <SearchComponent items={searchItems} client:load />
    </div>
  </div>
</Layout>
