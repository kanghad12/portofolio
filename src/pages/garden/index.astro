---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('garden');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title="Digital Garden (Catatan Belajar) — kanghadad.com" currentActive="garden">
  <div class="container">
    <div class="main-layout">
      <!-- Main Content -->
      <div class="content-area">
        <h1 style="font-size: 2.2rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 8px;">🌱 Digital Garden</h1>
        <p style="color: var(--text-muted); margin-bottom: 32px;">Tempat penyimpanan ide-ide mentah, catatan pembelajaran teknologi, dan wawasan yang terus tumbuh. Berbeda dengan blog biasa, catatan di sini terus diperbarui seiring bertambahnya pemahaman.</p>

        <div style="margin-bottom: 40px; background: var(--bg-alt); padding: 18px 24px; border-radius: 12px; border: 1px solid var(--border); font-size: 0.9rem;">
          <h4 style="font-weight: 700; margin-bottom: 8px; color: var(--accent-orange);">Panduan Pertumbuhan Catatan:</h4>
          <ul style="padding-left: 20px; line-height: 1.6;">
            <li><strong>🌱 Seedling (Bibit):</strong> Ide mentah, kutipan sekilas, atau coretan konsep awal.</li>
            <li><strong>🌿 Growing (Tumbuh):</strong> Catatan yang sedang aktif dikembangkan dan ditambahkan isinya.</li>
            <li><strong>🌳 Evergreen (Abadi):</strong> Catatan matang yang sudah lengkap, teruji, dan jarang berubah.</li>
          </ul>
        </div>

        {sortedPosts.length === 0 ? (
          <p style="color: var(--text-muted);">Belum ada catatan di Digital Garden.</p>
        ) : (
          <div class="garden-grid">
            {sortedPosts.map(post => (
              <PostCard entry={post} collection="garden" />
            ))}
          </div>
        )}
      </div>

      <!-- Sidebar -->
      <aside class="sidebar-area">
        <div class="widget">
          <h3 class="widget-title">Tentang Kebun Digital</h3>
          <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.6;">
            Ini adalah komitmen untuk "belajar di tempat terbuka" (*learning in public*). Ide-ide di sini ditanam sebagai bibit dan disiram terus-menerus hingga menjadi pohon pengetahuan yang kokoh.
          </p>
        </div>
      </aside>
    </div>
  </div>
</Layout>
