---
interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      tags: string[];
      category?: string;
      status?: 'seedling' | 'growing' | 'evergreen';
      duration?: number;
    };
  };
  collection: 'informatika' | 'risalah' | 'tutorial';
}

const { entry, collection } = Astro.props;
const { title, description, pubDate, tags, category, status, duration } = entry.data;

const formatDate = (date: Date) => {
  return date.toLocaleDateString('id-ID', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

const getCollectionBadgeClass = () => {
  if (collection === 'informatika') return 'card-tag tag-tkj';
  if (collection === 'risalah') return 'card-tag tag-islam';
  return 'card-tag tag-garden';
};

const getCollectionName = () => {
  if (collection === 'informatika') return 'Informatika';
  if (collection === 'risalah') return 'Risalah Dakwah';
  return 'Tutorial';
};
---

<article class="article-card">
  <span class={getCollectionBadgeClass()}>
    {getCollectionName()} {category ? `• ${category}` : ''}
  </span>
  

  <h3 class="card-title">
    <a href={`/${collection}/${entry.id}`}>{title}</a>
  </h3>
  
  <p class="card-excerpt">{description}</p>
  
  <div class="card-footer">
    <span>📅 {formatDate(pubDate)}</span>
    {duration && <span>• ⏱️ {duration} min baca</span>}
    {tags.length > 0 && (
      <span style="margin-left: auto; display: flex; gap: 8px;">
        {tags.map((tag) => (
          <span style="color: var(--accent-orange);">#{tag}</span>
        ))}
      </span>
    )}
  </div>
</article>
