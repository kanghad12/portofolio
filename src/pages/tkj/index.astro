---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('tkj');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title="Modul Pembelajaran TKJ — kanghadad.com" currentActive="tkj">
  <div class="container">
    <div class="main-layout">
      <!-- Main Content -->
      <div class="content-area">
        <h1 style="font-size: 2.2rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 8px;">🌐 Modul TKJ</h1>
        <p style="color: var(--text-muted); margin-bottom: 32px;">Panduan praktis konfigurasi jaringan MikroTik, Cisco, Linux Server, dan materi vokasi pendukung kompetensi siswa.</p>

        {sortedPosts.length === 0 ? (
          <p style="color: var(--text-muted);">Belum ada modul TKJ yang diterbitkan.</p>
        ) : (
          sortedPosts.map(post => (
            <PostCard entry={post} collection="tkj" />
          ))
        )}
      </div>

      <!-- Sidebar -->
      <aside class="sidebar-area">
        <div class="widget">
          <h3 class="widget-title">Kurikulum Vokasi</h3>
          <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.6;">
            Kumpulan panduan ini disesuaikan dengan kebutuhan kompetensi kerja siswa TKJ (Teknik Komputer & Jaringan) serta SKKNI Bidang Jaringan Komputer.
          </p>
        </div>
      </aside>
    </div>
  </div>
</Layout>
