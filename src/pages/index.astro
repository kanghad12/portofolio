---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

// Get and sort all content
const informatikaPosts = await getCollection('informatika');
const risalahPosts = await getCollection('risalah');
const tutorialPosts = await getCollection('tutorial');

// Map entries with collection name attached
const allPosts = [
  ...informatikaPosts.map(p => ({ ...p, collection: 'informatika' as const })),
  ...risalahPosts.map(p => ({ ...p, collection: 'risalah' as const })),
  ...tutorialPosts.map(p => ({ ...p, collection: 'tutorial' as const }))
];

// Sort posts by pubDate descending
const sortedPosts = allPosts.sort((a, b) => {
  return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
});

// Extract Spotlight (Featured Post) and Latest 3 updates
const featuredPost = sortedPosts[0];
const latestPosts = sortedPosts.slice(1, 4);

const formatDate = (date: Date) => {
  return date.toLocaleDateString('id-ID', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
---

<Layout title="Kang Hadad — Catatan Vokasi & Pemikiran Islam" currentActive="home">
  <!-- Hero Section -->
  <section class="hero" style="border-bottom: none; padding-bottom: 20px;">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-text">
          <span class="hero-badge">Pusat Catatan Terbuka</span>
          <h1 class="hero-title">Logika <span>Teknologi</span>, Vokasi & Value <span>Islam</span></h1>
          <p class="hero-description">
            Repositori materi dan pemikiran Kang Hadad — Guru Keterampilan Informatika & TKJ di MAN 2 Cianjur. Berisi modul jaringan komputer, pemrograman, risalah dakwah digital, serta kumpulan tutorial praktis.
          </p>
        </div>
        <div class="hero-meta">
          <div class="meta-item">
            <span class="meta-label">Institusi / Lokasi</span>
            <span class="meta-value">MAN 2 Cianjur (Plus Keterampilan)</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Stack Hosting</span>
            <span class="meta-value">Astro.build + Cloudflare Pages</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Fokus Bahasan</span>
            <span class="meta-value">Networking, Web, Cyber Ethics, Islam</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Navigation Category Grid -->
  <section class="main-categories" style="padding: 20px 0 40px 0; border-bottom: 1px solid var(--border); background-color: rgba(255, 125, 26, 0.01);">
    <div class="container">
      <h2 class="section-title">📂 Telusuri Koleksi Konten</h2>
      <div class="garden-grid">
        <div class="article-card" style="display: flex; flex-direction: column; height: 100%; margin-bottom: 0;">
          <div style="font-size: 2rem; margin-bottom: 12px;">🌐</div>
          <h3 style="font-size: 1.2rem; font-weight: 800; margin-bottom: 8px;">Materi Informatika</h3>
          <p style="font-size: 0.875rem; color: var(--text-muted); flex: 1; margin-bottom: 16px;">
            Modul pembelajaran jaringan komputer (MikroTik/Cisco), administrasi sistem, dan materi vokasi penunjang siswa.
          </p>
          <a href="/informatika" class="theme-toggle" style="text-decoration: none; justify-content: center; width: 100%; border-color: var(--accent-orange); color: var(--accent-orange);">
            Buka Materi Informatika
          </a>
        </div>
        
        <div class="article-card" style="display: flex; flex-direction: column; height: 100%; margin-bottom: 0;">
          <div style="font-size: 2rem; margin-bottom: 12px;">📖</div>
          <h3 style="font-size: 1.2rem; font-weight: 800; margin-bottom: 8px;">Risalah Dakwah</h3>
          <p style="font-size: 0.875rem; color: var(--text-muted); flex: 1; margin-bottom: 16px;">
            Esai keislaman, etika siber, dakwah digital, fikih muamalah kontemporer, dan ulasan kritik sosial.
          </p>
          <a href="/risalah" class="theme-toggle" style="text-decoration: none; justify-content: center; width: 100%; border-color: var(--accent-orange); color: var(--accent-orange);">
            Buka Risalah Dakwah
          </a>
        </div>
        
        <div class="article-card" style="display: flex; flex-direction: column; height: 100%; margin-bottom: 0;">
          <div style="font-size: 2rem; margin-bottom: 12px;">📚</div>
          <h3 style="font-size: 1.2rem; font-weight: 800; margin-bottom: 8px;">Kumpulan Tutorial</h3>
          <p style="font-size: 0.875rem; color: var(--text-muted); flex: 1; margin-bottom: 16px;">
            Panduan teknis langkah-demi-langkah, Web Development (Astro/React), Sysadmin, dan pemecahan masalah.
          </p>
          <a href="/tutorial" class="theme-toggle" style="text-decoration: none; justify-content: center; width: 100%; border-color: var(--accent-orange); color: var(--accent-orange);">
            Buka Kumpulan Tutorial
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Area -->
  <div class="container">
    <div class="main-layout" style="padding-top: 20px;">
      <!-- Main Content -->
      <div class="content-area">
        <!-- Spotlight / Featured Article Section -->
        {featuredPost && (
          <section style="margin-bottom: 40px;">
            <h2 class="section-title">📌 Sorotan Utama</h2>
            <div class="article-card" style="border-left: 4px solid var(--accent-orange); background: linear-gradient(180deg, var(--bg-card) 0%, rgba(255, 125, 26, 0.02) 100%);">
              <span class={featuredPost.collection === 'informatika' ? 'card-tag tag-tkj' : featuredPost.collection === 'risalah' ? 'card-tag tag-islam' : 'card-tag tag-garden'}>
                {featuredPost.collection === 'informatika' ? 'Informatika' : featuredPost.collection === 'risalah' ? 'Risalah' : 'Tutorial'} {featuredPost.data.category ? `• ${featuredPost.data.category}` : ''}
              </span>
              <h3 style="font-size: 1.6rem; font-weight: 800; line-height: 1.3; margin: 10px 0 12px 0;">
                <a href={`/${featuredPost.collection}/${featuredPost.id}`} style="color: var(--text-main); text-decoration: none; transition: color 0.2s;">
                  {featuredPost.data.title}
                </a>
              </h3>
              <p class="card-excerpt" style="font-size: 1rem; line-height: 1.6; margin-bottom: 20px; color: var(--text-muted);">{featuredPost.data.description}</p>
              <div class="card-footer" style="align-items: center; border-top: 1px solid var(--border); padding-top: 16px;">
                <span>📅 {formatDate(featuredPost.data.pubDate)}</span>
                {featuredPost.data.duration && <span>• ⏱️ {featuredPost.data.duration} min baca</span>}
                <a href={`/${featuredPost.collection}/${featuredPost.id}`} style="margin-left: auto; text-decoration: none; color: var(--accent-orange); font-weight: 700; font-size: 0.9rem; display: flex; align-items: center; gap: 4px;">
                  Baca Selengkapnya →
                </a>
              </div>
            </div>
          </section>
        )}

        <!-- Latest Updates Section -->
        <section>
          <h2 class="section-title">🕒 Catatan Terbaru</h2>
          
          {latestPosts.length === 0 ? (
            <p style="color: var(--text-muted);">Belum ada catatan lain yang ditulis.</p>
          ) : (
            latestPosts.map(post => (
              <PostCard entry={post} collection={post.collection} />
            ))
          )}
        </section>

        <!-- Search link promotion -->
        <div style="margin-top: 32px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 24px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; box-shadow: var(--shadow);">
          <div>
            <h4 style="font-weight: 700; font-size: 1.1rem; margin-bottom: 4px;">🔍 Cari Materi Lebih Spesifik?</h4>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0;">Gunakan pencarian cepat untuk mencari modul, esai dakwah, atau perintah konfigurasi jaringan.</p>
          </div>
          <a href="/search" class="theme-toggle" style="text-decoration: none; padding: 10px 20px; border-color: var(--accent-orange); color: var(--accent-orange); white-space: nowrap;">
            Buka Pencarian
          </a>
        </div>
      </div>

      <!-- Sidebar Section -->
      <aside class="sidebar-area">
        <div class="widget">
          <h3 class="widget-title">Tentang Penulis</h3>
          <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 12px; line-height: 1.6;">
            Guru Keterampilan Informatika & TKJ (Teknik Komputer & Jaringan) serta penggiat dakwah digital di Cianjur. Suka mengulik sistem jaringan komputer, web development, dan kajian keislaman.
          </p>
        </div>

        <div class="widget">
          <h3 class="widget-title">Kategori Utama</h3>
          <ul class="widget-list">
            <li><a href="/informatika">🌐 Materi Informatika</a></li>
            <li><a href="/risalah">📖 Risalah Dakwah</a></li>
            <li><a href="/tutorial">📚 Kumpulan Tutorial</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
